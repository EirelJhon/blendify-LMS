{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/create-course", "destination": "/create-course.html" },
    { "source": "/studio", "destination": "/create-course.html" }
  ]
}
